[Unit]
Description=Ostium control plane (Web UI, API, ACME)
Documentation=https://github.com/ThzxxArt/Ostium
After=network-online.target ostium-core.service
Wants=network-online.target
Requires=ostium-core.service

[Service]
Type=simple
User=ostium
Group=ostium
WorkingDirectory=/var/lib/ostium
Environment=OSTIUM_ROLE=server
Environment=OSTIUM_CONFIG_FILE=/etc/ostium/config.toml
Environment=OSTIUM_DATA_DIR=/var/lib/ostium
Environment=OSTIUM_CONFIG_DIR=/etc/ostium
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ostium/venv/bin/ostium serve
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/ostium /etc/ostium
LimitNOFILE=65535
Restart=always
RestartSec=3
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
