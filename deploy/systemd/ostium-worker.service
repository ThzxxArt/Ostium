[Unit]
Description=Ostium data-plane worker (sing-box supervisor)
Documentation=https://github.com/ThzxxArt/Ostium
After=network-online.target
Wants=network-online.target
Before=ostium-jobs.service

[Service]
Type=simple
User=ostium
Group=ostium
WorkingDirectory=/var/lib/ostium
EnvironmentFile=/etc/ostium/ostium.env
Environment=DJANGO_SETTINGS_MODULE=ostium.config.settings.prod
ExecStart=/opt/ostium/venv/bin/ostium worker
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# sing-box uses netlink to detect the outbound interface.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/ostium
LimitNOFILE=65535
Restart=always
RestartSec=2
UMask=0077

[Install]
WantedBy=multi-user.target
