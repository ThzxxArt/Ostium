[Unit]
Description=Ostium client console (root mode)
Documentation=https://github.com/ThzxxArt/Ostium
After=network-online.target ostium-core.service
Wants=network-online.target
Requires=ostium-core.service

[Service]
Type=simple
User=root
Group=root
Environment=OSTIUM_ROLE=client
Environment=OSTIUM_DATA_DIR=/var/lib/ostium
Environment=OSTIUM_CONFIG_FILE=/etc/ostium/client.toml
Environment=OSTIUM_CONFIG_DIR=/etc/ostium
Environment=OSTIUM_CORE_TOKEN_FILE=/var/lib/ostium-core/core.token
Environment=OSTIUM_CORE_URL=http://127.0.0.1:8788
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ostium/venv/bin/ostium serve
Restart=always
RestartSec=3
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=multi-user.target
