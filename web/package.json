{
  "name": "ostium-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/vue-query": "5.107.1",
    "@vueuse/core": "15.0.0",
    "codemirror": "6.0.2",
    "echarts": "6.1.0",
    "fuse.js": "7.5.0",
    "jsqr": "1.4.0",
    "lucide-vue-next": "1.0.0",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "qrcode.vue": "3.11.0",
    "vee-validate": "4.15.1",
    "vue": "3.5.45",
    "vue-codemirror": "6.1.1",
    "vue-echarts": "8.3.2",
    "vue-i18n": "11.4.18",
    "vue-router": "5.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "^16.5.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.0",
    "typescript": "^6.0.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
